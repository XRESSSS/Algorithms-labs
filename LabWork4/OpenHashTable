import math

# Константа золотого перетину (константа Кнута) для методу множення
A = (math.sqrt(5) - 1) / 2

# Список вхідних слів (Варіант 17)
WORDS = ["БІЛЬШЕ", "ДІЛА", "МЕНШЕ", "СЛІВ", "ОТАК", "ДОБУДЕШ", "ХЛІБ"]

# Словник позицій українських літер (згідно з Рис. 4.3)
LETTER_POSITIONS = {
    'А': 1,  'Б': 2,  'В': 3,  'Г': 4,  'Ґ': 5,  'Д': 6,  'Е': 7,
    'Є': 8,  'Ж': 9,  'З': 10, 'И': 11, 'І': 12, 'Ї': 13, 'Й': 14,
    'К': 15, 'Л': 16, 'М': 17, 'Н': 18, 'О': 19, 'П': 20, 'Р': 21,
    'С': 22, 'Т': 23, 'У': 24, 'Ф': 25, 'Х': 26, 'Ц': 27, 'Ч': 28,
    'Ш': 29, 'Щ': 30, 'Ь': 31, 'Ю': 32, 'Я': 33
}

def get_key_sum(key: str) -> int:
    """Обчислює суму позицій літер слова в українському алфавіті."""
    sum_of_positions = 0
    for char in key.upper():
        position = LETTER_POSITIONS.get(char, 0)
        sum_of_positions += position
    return sum_of_positions

def hash_division(key: str, m: int = 13) -> int:
    """Хеш-функція за методом ділення: h(k) = k mod m."""
    k = get_key_sum(key)
    return k % m

def hash_multiplication(key: str, m: int = 16) -> int:
    """Хеш-функція за методом множення: h(k) = floor(m * ((k * A) mod 1))."""
    k = get_key_sum(key)
    fractional_part = (k * A) % 1
    return math.floor(m * fractional_part)

def build_open_hash_table(words: list, m: int, hash_func) -> list:
    """Будує відкриту хеш-таблицю з роздільними ланцюжками (списками)."""
    # 1. Ініціалізація таблиці: m порожніх ланцюжків
    hash_table = [[] for _ in range(m)]

    # 2. Обробка кожного слова
    for word in words:
        address = hash_func(word, m)
        # Додавання слова до відповідного ланцюжка
        hash_table[address].append(word)

    return hash_table

def display_hash_table(table: list, title: str):
    """Виводить відкриту хеш-таблицю у зручному форматі."""
    m = len(table)
    print(f"\n--- Результат хешування ({title}, Таблиця M={m}) ---")
    for i, chain in enumerate(table):
        print(f"Індекс {i:02d}: {chain}")

# Виконання для методу ділення (M = 13)
open_table_div = build_open_hash_table(WORDS, 13, hash_division)
display_hash_table(open_table_div, "Метод ділення")

# Виконання для методу множення (M = 16)
open_table_mult = build_open_hash_table(WORDS, 16, hash_multiplication)
display_hash_table(open_table_mult, "Метод множення")
