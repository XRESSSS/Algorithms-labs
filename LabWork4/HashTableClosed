import math

A = (math.sqrt(5) - 1) / 2

WORDS = ["БІЛЬШЕ", "ДІЛА", "МЕНШЕ", "СЛІВ", "ОТАК", "ДОБУДЕШ", "ХЛІБ"]

# Словник позицій українських літер 
LETTER_POSITIONS = {
    'А': 1,  'Б': 2,  'В': 3,  'Г': 4,  'Ґ': 5,  'Д': 6,  'Е': 7,
    'Є': 8,  'Ж': 9,  'З': 10, 'И': 11, 'І': 12, 'Ї': 13, 'Й': 14,
    'К': 15, 'Л': 16, 'М': 17, 'Н': 18, 'О': 19, 'П': 20, 'Р': 21,
    'С': 22, 'Т': 23, 'У': 24, 'Ф': 25, 'Х': 26, 'Ц': 27, 'Ч': 28,
    'Ш': 29, 'Щ': 30, 'Ь': 31, 'Ю': 32, 'Я': 33
}

def get_key_sum(key: str) -> int:
    """Обчислює суму позицій літер слова в українському алфавіті."""
    sum_of_positions = 0
    for char in key.upper():
        position = LETTER_POSITIONS.get(char, 0)
        sum_of_positions += position
    return sum_of_positions

def primary_hash_division(key: str, m: int = 13) -> int:
    """Первинна хеш-функція за методом ділення: h(k) = k mod M."""
    return get_key_sum(key) % m

def primary_hash_multiplication(key: str, m: int = 16) -> int:
    """Первинна хеш-функція за методом множення: h(k) = floor(M * ((k * A) mod 1))."""
    k = get_key_sum(key)
    return math.floor(m * ((k * A) % 1))

def build_closed_hash_table(words: list, m: int, primary_hash_func) -> list:
    """
    Будує хеш-таблицю з відкритою адресацією,
    використовуючи лінійне дослідження.
    """
    # 1. Ініціалізація таблиці: m порожніх слотів (None як "порожній")
    hash_table = [None] * m
    inserted_count = 0

    # 2. Обробка кожного слова
    for word in words:
        # Крок 2а: Обчислення початкової адреси
        start_address = primary_hash_func(word, m)

        # Крок 2б: Лінійне дослідження (Linear Probing)
        for i in range(m):
            # h(k, i) = (h(k) + i) mod M
            address = (start_address + i) % m

            # Перевірка, чи комірка вільна
            if hash_table[address] is None:
                hash_table[address] = word
                inserted_count += 1
                break
        else:
            # Виконується, якщо цикл завершився без 'break' (таблиця повна)
            print(f"Помилка: Таблиця заповнена. Не вдалося додати слово: {word}")

    return hash_table

def display_closed_hash_table(table: list, title: str):
    """Виводить закриту хеш-таблицю у зручному форматі."""
    m = len(table)
    print(f"\n--- Хеш-таблиця (Відкрита адресація, {title}, M={m}) ---")
    print("Індекс | Слово")
    print("--------------------")
    for i, item in enumerate(table):
        value = item if item is not None else "(NULL)"
        print(f"{i:02d}     | {value}")

# Виконання для методу ділення (M = 13)
closed_table_div = build_closed_hash_table(WORDS, 13, primary_hash_division)
display_closed_hash_table(closed_table_div, "Метод ділення")

# Виконання для методу множення (M = 16)
closed_table_mult = build_closed_hash_table(WORDS, 16, primary_hash_multiplication)
display_closed_hash_table(closed_table_mult, "Метод множення")
